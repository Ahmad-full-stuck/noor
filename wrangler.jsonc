{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noor-private",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noor-private-vault",
      "database_id": "52b5685b-48d7-4775-a2b0-7f2ecafd0f3e",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "4658194ce72944cba5df9c427dcadc31"
    }
  ]
}
